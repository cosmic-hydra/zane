# ==============================================================================
# ZANE AI Drug Discovery Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in values as needed.
# All variables are optional unless noted otherwise.

# --- Authentication & API Keys ---

# Optional Hugging Face token for gated models
HF_TOKEN=

# Web search integrations (Google Custom Search)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional PubMed API key for higher request throughput
NCBI_API_KEY=

# Cerebras API key for hosted chat guidance
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# --- MLOps & Tracking ---

# MLflow tracking server URI
MLFLOW_TRACKING_URI=http://localhost:5000

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=zane-drug-discovery

# DVC remote storage
DVC_REMOTE_URL=

# --- Infrastructure ---

# Database connections (use Kubernetes secrets in production)
DATABASE_URL=
MONGODB_URI=mongodb://localhost:27017

# Redis for Celery task queue
REDIS_URL=redis://localhost:6379/0

# Ray cluster address
RAY_ADDRESS=

# --- Dashboard & UI ---

# Optional path to local Go search binary
ZANE_GO_SEARCH_BIN=

# Dashboard AI defaults
ZANE_DASHBOARD_AI=1
ZANE_AI_MODEL_ID=artifacts/llama/tinyllama-1.1b-chat

# Dashboard display
ZANE_COLOR_SYSTEM=auto
ZANE_DASHBOARD_WIDTH=
ZANE_DASHBOARD_LOGO_URL=

# --- Runtime Paths ---

ZANE_DATA_DIR=data
ZANE_CHECKPOINT_DIR=checkpoints
ZANE_LOG_DIR=logs
ZANE_OUTPUT_DIR=outputs

# --- Security ---

# JWT secret for API authentication (generate a random value for production)
JWT_SECRET_KEY=

# FPGA/ASIC device path (for neuromorphic/quantum modules)
FPGA_DEVICE=
